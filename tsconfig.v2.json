{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "lib": ["ES2017", "DOM"],
    "jsx": "react",
    "declaration": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/tool/**/*",
    "src/types.ts",
    "src/utils/**/*",
    "src/components/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
